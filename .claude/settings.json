{
  "_comment": "Karta projektu: CLAUDE.md. SessionStart wstrzykuje najpierw gotowe ustalenia ze stan-zespolu, a gdy ich nie ma — indeks skrzynki zadań. Lokalni agenci są w .claude/agents/. Bramka dotyczy wyłącznie publikacji EAS/Expo, nie lokalnego startu aplikacji.",
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm run *)",
      "Read",
      "Edit(.claude/*)",
      "Write(.claude/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/przed-deployem.sh\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Bramka publikacji — Strażnik Jakości"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/inject-context.sh\"",
            "statusMessage": "Sprawdzam stan zespołu i skrzynkę zadań"
          }
        ]
      }
    ]
  }
}
